# Скопируй этот файл в .env и впиши свои значения
# Какой ИИ использовать: gemini или openai
AI_PROVIDER=gemini
# Ключ Gemini берётся бесплатно на https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Запасной вариант (если AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true - заготовленные ответы без API (для демо без интернета), false - настоящий ИИ
MOCK_AI=true
PORT=3000
